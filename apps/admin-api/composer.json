{
  "name": "plog/admin-api",
  "type": "project",
  "description": "Plog Admin API - RESTful API for admin panel",
  "keywords": ["api", "admin", "rest"],
  "license": "MIT",
  "authors": [
    {
      "name": "Plog Team",
      "email": "team@plog.dev"
    }
  ],
  "require": {
    "php": "^7.4|^8.0",
    "ext-json": "*",
    "plog/core": "^1.0",
    "plog/db": "^1.0",
    "plog/auth": "^1.0",
    "plog/content": "^1.0",
    "psr/http-message": "^1.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Plog\\AdminApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Plog\\AdminApi\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
