{
  "name": "plog/plog-monorepo",
  "type": "project",
  "description": "Plog CMS Monorepo - Modern content management system",
  "keywords": ["cms", "blog", "monorepo", "php"],
  "license": "MIT",
  "authors": [
    {
      "name": "Plog Team",
      "email": "team@plog.dev"
    }
  ],
  "require": {
    "php": "^7.4|^8.0",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "vlucas/phpdotenv": "^5.0",
    "monolog/monolog": "^2.0",
    "psr/container": "^1.0",
    "psr/log": "^1.1",
    "psr/http-message": "^1.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "squizlabs/php_codesniffer": "^3.0",
    "phpstan/phpstan": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Plog\\Core\\": "packages/core/src/",
      "Plog\\Db\\": "packages/db/src/",
      "Plog\\Auth\\": "packages/auth/src/",
      "Plog\\Content\\": "packages/content/src/",
      "Plog\\AdminApi\\": "apps/admin-api/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Plog\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html coverage",
    "cs:check": "phpcs --standard=PSR12",
    "cs:fix": "phpcbf --standard=PSR12",
    "stan": "phpstan analyse",
    "check": [
      "@cs:check",
      "@stan",
      "@test"
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/*",
      "options": {
        "symlink": true
      }
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
