{
  "server": {
    "host": "192.168.31.14",
    "user": "root",
    "port": 22,
    "comment": "SSH服务器配置"
  },
  "theme": {
    "name": "mytheme",
    "local_path": "f:/mytheme/content/templates",
    "remote_path": "/opt/1panel/docker/compose/emlog/data/content/templates/mytheme",
    "comment": "主题配置: name=主题名称, local_path=本地主题父目录, remote_path=远程主题完整路径(可选,留空则自动检测)"
  },
  "docker": {
    "container_name": "emlog-pro",
    "web_port": 8080,
    "file_owner": "www-data:www-data",
    "comment": "Docker配置: container_name=容器名称, web_port=Web端口, file_owner=文件所有者"
  }
}
