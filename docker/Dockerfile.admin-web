# syntax=docker/dockerfile:1

# =============================================================================
# Admin Web Dockerfile - 多阶段构建
# =============================================================================

# -----------------------------------------------------------------------------
# 阶段 1: 构建阶段
# -----------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /build

# 复制 package 文件
COPY apps/admin-web/package.json apps/admin-web/package-lock.json* ./

# 安装依赖
RUN npm ci --ignore-scripts --legacy-peer-deps --legacy-peer-deps

# 复制源代码
COPY apps/admin-web/ ./

# 构建应用
RUN npm run build

# -----------------------------------------------------------------------------
# 阶段 2: 生产阶段
# -----------------------------------------------------------------------------
FROM nginx:alpine

# 复制构建产物
COPY --from=builder /build/dist /usr/share/nginx/html

# 复制 Nginx 配置
COPY docker/nginx.admin-web.conf /etc/nginx/conf.d/default.conf

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
