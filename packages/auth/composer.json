{
  "name": "plog/auth",
  "type": "library",
  "description": "Plog Authentication Package - Auth, Session, and Password Hashing",
  "keywords": ["auth", "authentication", "session", "password"],
  "license": "MIT",
  "authors": [
    {
      "name": "Plog Team",
      "email": "team@plog.dev"
    }
  ],
  "require": {
    "php": "^7.4|^8.0",
    "plog/core": "^1.0",
    "plog/db": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Plog\\Auth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Plog\\Auth\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
