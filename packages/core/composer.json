{
  "name": "plog/core",
  "type": "library",
  "description": "Plog Core Package - Configuration, Logging, Events, and Container",
  "keywords": ["core", "config", "log", "event", "container"],
  "license": "MIT",
  "authors": [
    {
      "name": "Plog Team",
      "email": "team@plog.dev"
    }
  ],
  "require": {
    "php": "^7.4|^8.0",
    "psr/container": "^1.0",
    "psr/log": "^1.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Plog\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Plog\\Core\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
