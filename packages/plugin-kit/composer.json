{
  "name": "plog/plugin-kit",
  "description": "Plog Plugin Development Kit",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Plog Team",
      "email": "team@plog.dev"
    }
  ],
  "require": {
    "php": "^7.4|^8.0",
    "plog/core": "^1.0.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Plog\\Plugin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Plog\\Plugin\\Tests\\": "tests/"
    }
  }
}
