<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../vendor/autoload.php"
         colors="true"
         verbose="true">
    
    <testsuites>
        <testsuite name="API Tests">
            <directory>./</directory>
        </testsuite>
    </testsuites>

    <php>
        <env name="API_BASE_URL" value="http://localhost:8080/api" />
        <env name="TEST_USERNAME" value="admin" />
        <env name="TEST_PASSWORD" value="password123" />
    </php>
</phpunit>
